# Buildroot rootfs images do not ship a native target compiler.
# Keep this fragment limited to runtime/debugging tools that are actually
# installable in the guest.
BR2_PACKAGE_MAKE=y
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_GDB=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_PATCH=y
